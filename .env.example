# Vornetic ayarları — bu dosyayı ".env" adıyla kopyala ve doldur.
# (.env gizlidir, kimseyle paylaşma.)

# Panel şifresi (mutlaka değiştir)
ADMIN_PASSWORD=buraya-guclu-bir-sifre

# Sitenin adresi (yayına alınca). NODE_ENV=production iken ZORUNLU: https:// ile, sonunda yol olmadan.
# Yoksa site açılmaz (e-posta linkleri sahte adrese yönlendirilemesin diye).
# PUBLIC_URL=https://vornetic.com
# NODE_ENV=production

# E-posta (Brevo örneği — README'de adım adım)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=brevo-giris-adresin
# SMTP_PASS=brevo-smtp-anahtari
# MAIL_FROM=Vornetic <info@vornetic.com>

# Kartla ödeme (Stripe)
# STRIPE_SECRET_KEY=sk_live_...
