# Settings for scripts/backup-offsite.sh. Copy this file to scripts/backup.env on the server and
# fill it in (README → Yedek). scripts/backup.env is not in git.

# Your age PUBLIC key (the "Public key: age1..." line that age-keygen printed on YOUR computer).
# Never put the private key (AGE-SECRET-KEY-...) on the server.
AGE_RECIPIENT=age1...

# Where the encrypted copies go: an rclone remote and folder (set up with: rclone config)
RCLONE_REMOTE=gdrive:vornetic-backups

# Delete copies there older than this many days (at least 7)
BACKUP_KEEP_DAYS=30
